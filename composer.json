{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "luinuxscl/lnx-sam",
    "description": "Runtime of the Sam platform agent: contributor registry, declared capabilities, read and proposal tools, and read-only introspection commands.",
    "keywords": [
        "laravel",
        "agent",
        "ai",
        "mcp"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.0",
        "laravel/mcp": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "livewire/livewire": "Required when a package registers a Sam surface (Livewire component)."
    },
    "autoload": {
        "psr-4": {
            "Luinuxscl\\LnxSam\\": "src/"
        },
        "files": [
            "src/aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Luinuxscl\\LnxSam\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Luinuxscl\\LnxSam\\LnxSamServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
